# Planning docs and the issue backlog stay local (owner's choice, 2026-10-25)
/docs/
/issues/

# Raw Elexon downloads stay local; `python -m scripts.fetch_data` rebuilds them (docs/data_notes.md §5)
/backend/data/raw/*
!/backend/data/raw/.gitkeep
# backend/data/processed/ IS committed on purpose (PRD FR-1.4, ADR 0001; confirmed by the owner
# 2026-10-25): actuals.parquet, forecasts.parquet, quality_report.json. Only stray temp files are ignored.
/backend/data/processed/*.tmp

